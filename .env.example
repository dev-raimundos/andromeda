# ==============================================================================
# Configuração de Variáveis de Ambiente - Coeur API
# ==============================================================================

# Perfil ativo da aplicação (dev habilita o Swagger em /swagger-ui.html; use staging/production nos demais ambientes)
SPRING_PROFILES_ACTIVE=dev

# Portas expostas no Docker
APP_PORT=8080
REDIS_PORT=6379

# Ativa o serviço "app" do compose.yaml (build + run do próprio container da aplicação).
# Deixe vazio/comentado em desenvolvimento local — a app roda direto pela IDE/Maven.
# Defina como "prod" apenas no ambiente de deploy (ex.: variável de ambiente no Dokploy).
COMPOSE_PROFILES=

# Conexão com o Banco de Dados PostgreSQL (Supabase)
# Connection string disponível em Project Settings > Database > Connection string.
# O Supabase exige SSL em conexões externas.
DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=secret

# Ativação/Desativação de Migrações Flyway
FLYWAY_ENABLED=true

# Conexão com o Servidor Redis
REDIS_HOST=localhost
REDIS_PASSWORD=

# Supabase (API/Auth)
# Disponível em Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
