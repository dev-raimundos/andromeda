# ==============================================================================
# Configuração de Variáveis de Ambiente - Coeur API
# ==============================================================================

# Perfil ativo da aplicação (dev habilita o Swagger em /swagger-ui.html; use staging/production nos demais ambientes)
SPRING_PROFILES_ACTIVE=dev

# Portas expostas no Docker
APP_PORT=8080
REDIS_PORT=6379
POSTGRES_PORT=5432

# Profiles do compose.yaml ativados (separados por vírgula):
#   local-db -> sobe um PostgreSQL 18 local com volume persistente. A app (rodando pela IDE/Maven)
#               passa a usar esse banco automaticamente, ignorando DATABASE_URL/USERNAME/PASSWORD.
#   prod     -> sobe o serviço "app" (build + run do próprio container).
# Vazio = nenhum dos dois: a app usa o banco definido em DATABASE_URL (ex.: Postgres on-premise).
COMPOSE_PROFILES=local-db

# Credenciais do PostgreSQL local (usadas só com o profile local-db).
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secret

# Conexão com o Banco de Dados PostgreSQL (on-premise).
# Usada quando COMPOSE_PROFILES não contém "local-db" e pelo serviço "app" do profile "prod".
# Com "local-db" ativo, estas três variáveis são ignoradas pela app.
DATABASE_URL=jdbc:postgresql://<host>:5432/<database>
DATABASE_USERNAME=<usuario>
DATABASE_PASSWORD=<senha>

# Ativação/Desativação de Migrações Flyway
FLYWAY_ENABLED=true

# Conexão com o Servidor Redis
REDIS_HOST=localhost
REDIS_PASSWORD=
