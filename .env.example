# ==============================================================================
# Configuração de Variáveis de Ambiente - Coeur API
# ==============================================================================

# Perfil ativo da aplicação (dev habilita o Swagger em /swagger-ui.html; use staging/production nos demais ambientes)
SPRING_PROFILES_ACTIVE=dev

# Porta exposta no Docker (apenas para o profile "prod", que builda e roda a app em container)
APP_PORT=8080

# Profiles do compose.yaml ativados (separados por vírgula):
#   prod -> sobe o serviço "app" (build + run do próprio container).
# Vazio = nenhum serviço local; a app (rodando pela IDE/Maven ou em "prod") sempre usa
# o Postgres e o Redis externos definidos abaixo.
COMPOSE_PROFILES=

# Conexão com o Banco de Dados PostgreSQL (externo/on-premise).
DATABASE_URL=jdbc:postgresql://<host>:5432/<database>
DATABASE_USERNAME=<usuario>
DATABASE_PASSWORD=<senha>

# Ativação/Desativação de Migrações Flyway
FLYWAY_ENABLED=true

# Conexão com o Servidor Redis (externo)
REDIS_HOST=<host>
REDIS_PORT=6379
REDIS_PASSWORD=

# Origens permitidas via CORS (separadas por vírgula). Padrão: front Angular local.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Chaves PEM persistentes (PKCS#8 privada e X.509 pública). Nunca versionar.
# Em dev, o primeiro início cria o par local; produção exige os arquivos existentes.
JWT_PUBLIC_KEY=file:certs/jwt-public.pem
JWT_PRIVATE_KEY=file:certs/jwt-private.pem
# Diretório montado como somente leitura no container (deve conter o mesmo par).
JWT_KEYS_DIRECTORY=./certs
CONTAINER_SPRING_PROFILES_ACTIVE=prod

# IPs exatos dos proxies confiáveis, separados por vírgula. Vazio ignora X-Forwarded-For.
# Configure apenas proxies que controlem/anexem corretamente a cadeia X-Forwarded-For.
TRUSTED_PROXIES=
